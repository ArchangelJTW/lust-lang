struct Node
    value: int
    left: Option<Node>
    right: Option<Node>
end

function build(depth: int, value: int): Node
    if depth == 0 then
        return Node { value = value, left = Option.None, right = Option.None }
    end
    local l: Node = build(depth - 1, value * 2)
    local r: Node = build(depth - 1, value * 2 + 1)
    return Node { value = value, left = Option.Some(l), right = Option.Some(r) }
end

function sum(node: Node): int
    local s: int = node.value
    if node.left is Some(l) then
        s = s + sum(l)
    end
    if node.right is Some(r) then
        s = s + sum(r)
    end
    return s
end

function count_even(arr: Array<int>): int
    local c: int = 0
    local i: int = 0
    while i < array.len(arr) do
        if arr[i] is Ok(v) then
            if v % 2 == 0 then
                c = c + 1
            end
        end
        i = i + 1
    end
    return c
end

local tree: Node = build(14, 1)
local total: int = 0
local pass: int = 0
while pass < 20 do
    total = total + sum(tree)
    pass = pass + 1
end
local arr: Array<int> = []
local k: int = 0
while k < 1000 do
    array.push(arr, k * 3)
    k = k + 1
end
local evens: int = 0
local j: int = 0
while j < 2000 do
    evens = evens + count_even(arr)
    j = j + 1
end
println(total + evens)
