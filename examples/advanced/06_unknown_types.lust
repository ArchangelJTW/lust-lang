-- Unknown Types Demo
-- Demonstrates dynamic typing with 'unknown' type and safe casting

local data: Map<string, unknown> = {
    name = "Alice",
    age = 30,
    active = true
}

println("Map length: " .. tostring(map.len(data)))

local name_opt = map.get(data, "name")
if name_opt is Some(name_val) then
    local name_str = name_val as string
    if name_str is Some(name) then
        println("Name: " .. name)
    end
end

local age_opt = map.get(data, "age")
if age_opt is Some(age_val) then
    local age_int = age_val as int
    if age_int is Some(age) then
        println("Age: " .. tostring(age))
    end
end
