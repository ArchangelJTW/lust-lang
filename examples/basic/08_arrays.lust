-- Arrays with module functions

-- Array literal with type inference
local numbers: Array<int> = [1, 2, 3, 4, 5]
local names = ["Alice", "Bob", "Charlie"]

-- Basic module functions
println(array.len(numbers))        -- Outputs: 5
println(array.is_empty(numbers))   -- Outputs: false

-- Accessing elements
local first = array.first(numbers)
if first:is_some() then
    println(first:unwrap())   -- Outputs: 1
end

local last = array.last(numbers)
if last:is_some() then
    println(last:unwrap())    -- Outputs: 5
end

-- Bracket reads return Result<T, IndexError> with bounds details
if numbers[2] is Ok(value) then
    println(value)            -- Outputs: 3
end

if numbers[20] is Err(error) then
    println(error.index)      -- Outputs: 20
    println(error.length)     -- Outputs: 5
end

-- get() returns Option<T> when only presence matters
local third = array.get(numbers, 2)
if third:is_some() then
    println(third:unwrap())   -- Outputs: 3
end

-- Mutable operations
array.push(numbers, 6)
println(array.len(numbers))        -- Outputs: 6

local popped = array.pop(numbers)
if popped:is_some() then
    println(popped:unwrap())  -- Outputs: 6
end

-- Slicing (creates new array)
local sliced = array.slice(numbers, 1, 3)
println(array.len(sliced))         -- Outputs: 2
 
