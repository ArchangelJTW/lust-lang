-- String module functions

local text = "Hello, World!"

-- Basic functions
println(string.len(text))                    -- Outputs: 13
println(string.is_empty(text))               -- Outputs: false

-- Searching
println(string.starts_with(text, "Hello"))    -- Outputs: true
println(string.ends_with(text, "!"))          -- Outputs: true
println(string.contains(text, "World"))       -- Outputs: true

-- Substring
println(string.sub(text, 1, 5))              -- Outputs: Hello

-- Case conversion
println(string.upper(text))                  -- Outputs: HELLO, WORLD!
println(string.lower(text))                  -- Outputs: hello, world!

-- Trimming
local padded = "  spaces  "
println(string.trim(padded))                -- Outputs: spaces
println(string.trim_start(padded))          -- Outputs: spaces
println(string.trim_end(padded))            -- Outputs:   spaces

-- Replace
println(string.replace(text, "World", "Lust"))  -- Outputs: Hello, Lust!

-- Split
local words = string.split(text, ", ")
println(array.len(words))                  -- Outputs: 2
 

