-- Maps with module functions

local scores: Map<string, int> = {
    Alice = 100,
    Bob = 85,
    Charlie = 92
}

-- Basic functions
println(map.len(scores))                 -- Outputs: 3
println(map.is_empty(scores))            -- Outputs: false

-- Querying
println(map.has(scores, "Alice"))        -- Outputs: true
println(map.has(scores, "David"))        -- Outputs: false

-- Accessing values
local alice_score = map.get(scores, "Alice")
if alice_score:is_some() then
    println(alice_score:unwrap())        -- Outputs: 100
end

-- Setting values
map.set(scores, "David", 95)
println(map.len(scores))                 -- Outputs: 4

-- Keys and Values
local all_names = map.keys(scores)
println(array.len(all_names))            -- Outputs: 4

local all_scores = map.values(scores)
println(array.len(all_scores))           -- Outputs: 4

-- Deleting
local removed = map.delete(scores, "Bob")
if removed:is_some() then
    println(removed:unwrap())            -- Outputs: 85
end

println(map.len(scores))                 -- Outputs: 3
