-- Type casting with `is` and `as`
-- Type casting returns Option for safe narrowing or boolean check

local data: Map<string, unknown> = {}
map.set(data, "age", 30)
map.set(data, "name", "Alice")

local age_opt = map.get(data, "age")
if age_opt:is_some() then
    local unknown_val = age_opt:unwrap()  -- Unknown type

    -- Safe cast using `as` which returns Option<T>
    local int_val = unknown_val as int
    if int_val:is_some() then
        println(int_val:unwrap())         -- Outputs: 30
    end

    -- Failed cast returns None
    local str_val = unknown_val as string
    if str_val:is_none() then
        println("Not a string")           -- Outputs: Not a string
    end
end

-- Direct type check using `is`
local name_opt = map.get(data, "name")
if name_opt:is_some() then
    local unknown_name = name_opt:unwrap()
    local str_name = unknown_name as string
    if str_name:is_some() then
        println(str_name:unwrap())        -- Outputs: Alice
    end
end
