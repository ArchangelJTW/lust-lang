-- Math module functions for floats and ints

-- Float functions
local x: float = 3.7
println(math.floor(x))           -- Outputs: 3
println(math.ceil(x))            -- Outputs: 4
println(math.round(x))           -- Outputs: 4

local y: float = 16.0
println(math.sqrt(y))            -- Outputs: 4

local z: float = -5.5
println(math.abs(z))             -- Outputs: 5.5

local t: float = 1.0
println(math.sin(t))             -- Outputs: 0.8414709848
println(math.cos(t))             -- Outputs: 0.5403023059
println(math.tan(t))             -- Outputs: 1.5574077247
println(math.asin(t))            -- Outputs: 1.5707963268
println(math.acos(t))            -- Outputs: 0
println(math.atan(t))            -- Outputs: 0.7853981634
println(math.atan2(t, 1.0))      -- Outputs: 0.7853981634

local w: float = 7.5
println(math.clamp(w, 0.0, 10.0))  -- Outputs: 7.5
println(math.clamp(w, 0.0, 5.0))   -- Outputs: 5

-- Int functions
local a: int = -42
println(math.abs(a))             -- Outputs: 42

local b: int = 75
println(math.clamp(b, 0, 100))     -- Outputs: 75
println(math.clamp(b, 0, 50))      -- Outputs: 50
 
