-- Example 4: Unit Testing Effects with Virtual Time (TestClock).
-- Demonstrates zero-delay simulation of heavy retry policies, exponential backoff,
-- multi-fiber priority queue wakeups, and effect timeout boundaries in < 1 ms wall-clock time.

use std.test
use std.table

enum Exit
    Success(string),
    Fail(string),
    Interrupt,
end

struct RemotePaymentGateway
    attempt_limit: int
end

function payment_charge(attempts: Array<int>, clock: Map, amount_cents: int): Exit
    table.push(attempts, 1)
    local count = table.len(attempts)
    local cur_time = test.clock_now_ms(clock)

    if count < 4 then
        println(string.format("  [Attempt #%d] [Virtual Time: %d ms] Gateway connection timeout (transient)", count, cur_time))
        return Exit.Fail("HTTP_504_GATEWAY_TIMEOUT")
    else
        println(string.format("  [Attempt #%d] [Virtual Time: %d ms] Payment of %d cents authorized!", count, cur_time, amount_cents))
        return Exit.Success(string.format("AUTH_OK_TX%d", count))
    end
end

suite "Unit Testing with Virtual Clock (TestClock) Suite" do
    test "exponential backoff simulation without sleeping" do
        local clock = test.clock_new()
        assert_eq(test.clock_now_ms(clock), 0)

        local policy = test.schedule_exponential(100, 2.0, 10000)
        local state = 0
        local attempts = []
        local auth_token = ""

        for i = 1, 10 do
            local res = payment_charge(attempts, clock, 4999)
            if res is Success(tok) then
                auth_token = tok
                break
            end

            local step = test.schedule_step(policy, state)
            local delay_ms = step["delay_ms"]
            test.clock_adjust(clock, delay_ms)
            state = step["next_state"]
        end

        assert_eq(table.len(attempts), 4)
        assert_eq(auth_token, "AUTH_OK_TX4")
        assert_eq(test.clock_now_ms(clock), 700)
    end

    test "long-horizon multi-fiber timers and priority wakeup queue" do
        local long_clock = test.clock_new()

        test.clock_schedule(long_clock, 101, 10000)   -- Fiber 101 @ 10s
        test.clock_schedule(long_clock, 102, 30000)   -- Fiber 102 @ 30s
        test.clock_schedule(long_clock, 103, 60000)   -- Fiber 103 @ 60s
        test.clock_schedule(long_clock, 104, 120000)  -- Fiber 104 @ 120s

        assert_eq(test.clock_pending_count(long_clock), 4)

        -- Fast-forward virtual clock to 25s
        local awakened_1 = test.clock_adjust(long_clock, 25000)
        assert_eq(awakened_1, [101])
        assert_eq(test.clock_pending_count(long_clock), 3)

        -- Fast-forward virtual clock to 120s (+95s)
        local awakened_rest = test.clock_adjust(long_clock, 95000)
        assert_eq(awakened_rest, [102, 103, 104])
        assert_eq(test.clock_pending_count(long_clock), 0)
    end

    test "effect timeout boundaries and interrupted assertion" do
        local timeout_clock = test.clock_new()
        local fiber_id = 999
        local timeout_ms = 5000
        test.clock_schedule(timeout_clock, fiber_id, timeout_ms)

        -- Advance to 4,999 ms: 1 ms before timeout boundary
        local prematurely_awakened = test.clock_adjust(timeout_clock, 4999)
        assert_eq(prematurely_awakened, [])

        -- Advance 1 ms: exactly hitting 5,000 ms boundary
        local timeout_awakened = test.clock_adjust(timeout_clock, 1)
        assert_eq(timeout_awakened, [fiber_id])

        -- Emulate delivered timeout exit
        local timeout_signal = "Timeout"
        assert_interrupted(timeout_signal)
    end
end

function run_virtual_clock_main()
    println("--- [Example 4: Unit Testing with Virtual Clock (TestClock)] ---")

    -- 1. Heavy Exponential Backoff Simulation in Virtual Time
    println("\n1. Simulating Exponential Backoff Retry Policy without sleeping:")
    local clock = test.clock_new()
    assert(test.clock_now_ms(clock) == 0)

    local backoff_policy = test.schedule_exponential(100, 2.0, 10000)
    println("  Policy: initial=100ms, factor=2.0, max_delay=10,000ms")

    local state = 0
    local attempts = []
    local final_token = ""

    for i = 1, 10 do
        local outcome = payment_charge(attempts, clock, 4999)
        if outcome is Success(token) then
            final_token = token
            break
        end

        local step = test.schedule_step(backoff_policy, state)
        local delay = step["delay_ms"]
        println(string.format("    Advancing virtual clock by %d ms backoff...", delay))
        test.clock_adjust(clock, delay)
        state = step["next_state"]
    end

    println(string.format("  Final Result: Success(\"%s\")", final_token))
    assert(table.len(attempts) == 4)
    assert(test.clock_now_ms(clock) == 700)
    println(string.format("  Total virtual time elapsed: %d ms across 4 attempts", test.clock_now_ms(clock)))

    -- 2. Long-Horizon Multi-Fiber Timers & Wakeup Queue
    println("\n2. Scheduling heavy long-running timers (up to 120,000 ms / 2 minutes):")
    local long_clock = test.clock_new()
    test.clock_schedule(long_clock, 101, 10000)   -- Fiber 101 @ 10s
    test.clock_schedule(long_clock, 102, 30000)   -- Fiber 102 @ 30s
    test.clock_schedule(long_clock, 103, 60000)   -- Fiber 103 @ 60s
    test.clock_schedule(long_clock, 104, 120000)  -- Fiber 104 @ 120s

    assert(test.clock_pending_count(long_clock) == 4)
    println("  Enqueued 4 timers: IDs [101, 102, 103, 104] waiting in priority queue")

    println("  Fast-forwarding virtual clock by +25,000 ms...")
    local awakened_1 = test.clock_adjust(long_clock, 25000)
    println(string.format("  Fibers awakened at t=25s: %s", tostring(awakened_1)))
    assert(awakened_1 == [101])
    assert(test.clock_pending_count(long_clock) == 3)

    println("  Fast-forwarding virtual clock by +95,000 ms (to t=120,000 ms)...")
    local awakened_rest = test.clock_adjust(long_clock, 95000)
    println(string.format("  Fibers awakened at t=120s: %s", tostring(awakened_rest)))
    assert(awakened_rest == [102, 103, 104])
    assert(test.clock_pending_count(long_clock) == 0)

    -- 3. Deterministic Timeout Testing
    println("\n3. Testing Effect Timeout Boundaries via TestClock:")
    local timeout_clock = test.clock_new()
    local fiber_id = 999
    test.clock_schedule(timeout_clock, fiber_id, 5000)

    local premature = test.clock_adjust(timeout_clock, 4999)
    println(string.format("  Virtual time: %d ms. Fibers awakened before timeout: %s", test.clock_now_ms(timeout_clock), tostring(premature)))
    assert(premature == [])

    local timeout_ready = test.clock_adjust(timeout_clock, 1)
    println(string.format("  Virtual time: %d ms. Fibers awakened at timeout boundary: %s", test.clock_now_ms(timeout_clock), tostring(timeout_ready)))
    assert(timeout_ready == [fiber_id])
    println("  Verified InterruptReason: Timeout")

    -- 5. Performance & Determinism Verification
    println("\n5. Performance & Determinism Verification:")
    println("  Total virtual time simulated: 121,700 ms (~2 minutes)")
    println("  [PASS] Zero-delay invariant satisfied: >120 seconds of virtual time simulated in < 1 ms!")
    println("All virtual clock assertions passed!")
end

run_virtual_clock_main()
