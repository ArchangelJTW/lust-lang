-- An error deep inside an inner loop on a late iteration: the state the
-- outer trace had written back must be exact.
function run(): int
    local total: int = 0
    local i: int = 0
    while i < 50 do
        local j: int = 0
        while j < 50 do
            local k: int = 0
            while k < 50 do
                total = total + (i + j + k) % 3
                if i == 40 and j == 30 and k == 20 then
                    println(total)
                    total = total / (k - 20)
                end
                k = k + 1
            end
            j = j + 1
        end
        i = i + 1
    end
    return total
end
println(run())
