-- Three loop levels, a break, zero-trip inner loops, floats and an array
-- built across iterations: the outer traces call the inner loops' traces.
function run(): int
    local total: int = 0
    local acc: float = 0.0
    local arr: Array<int> = []
    local i: int = 0
    while i < 60 do
        local j: int = 0
        while j < (i % 7) do
            local k: int = 0
            while k < 50 do
                if k == i then break end
                total = total + (i * j + k) % 5
                acc = acc + 0.5
                k = k + 1
            end
            array.push(arr, total)
            j = j + 1
        end
        if i % 3 == 0 then
            local m: int = 0
            while m < 20 do
                total = total - 1
                m = m + 1
            end
        end
        i = i + 1
    end
    println(acc)
    println(array.len(arr))
    return total
end
println(run())
