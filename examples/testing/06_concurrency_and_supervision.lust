-- Lust Lang Testing Framework - Structured Concurrency, Fiber Supervision & Gate-NEG-02
-- Demonstrates fiber hierarchies in Scope, cascading cancellation on failure,
-- deferred interrupt masking, Gate-NEG-02 invariant, and guaranteed LIFO finalization.

suite "Structured Concurrency, Supervision & Gate-NEG-02 Suite" do
    test "scope lifecycle, cascading teardown, masking, and LIFO finalization" do
        -- 1. Initialize Root Scope #100 and acquire scoped resources
        local scope = test.scope_new(100)
        assert(test.scope_is_open(scope))
        assert_eq(test.scope_teardown_state(scope), "Idle")

        -- Acquire resources in sequential order: 1 -> 2 -> 3
        local res1 = test.resource_new("PostgreSQL Connection Pool")
        test.scope_register_finalizer(scope, res1)

        local res2 = test.resource_new("TCP Socket Listener")
        test.scope_register_finalizer(scope, res2)

        local res3 = test.resource_new("Worker Scratch Arena Buffer")
        test.scope_register_finalizer(scope, res3)

        assert_eq(test.resource_is_active(res1), true)
        assert_eq(test.resource_is_active(res2), true)
        assert_eq(test.resource_is_active(res3), true)

        -- 2. Spawning child fiber tree under Scope #100
        local fiber_a = test.fiber_new(101, 100)
        local fiber_b = test.fiber_new(102, 100)
        local fiber_c = test.fiber_new(103, 100)

        test.scope_register_child(scope, fiber_a)
        test.scope_register_child(scope, fiber_b)
        test.scope_register_child(scope, fiber_c)

        -- Fiber B enters an interrupt-masked critical section
        test.fiber_enter_mask(fiber_b)
        assert(test.fiber_is_masked(fiber_b), "Fiber B must be masked")

        -- 3. Failure in Worker C triggers cascading scope teardown
        test.fiber_set_state(fiber_c, "Failed")
        assert_eq(test.fiber_state(fiber_c), "Failed")

        local children_to_cancel = test.scope_begin_teardown(scope)
        assert_eq(children_to_cancel, [101, 102, 103])

        -- Invariant 1: Admission is strictly closed
        assert_eq(test.scope_admission_state(scope), "Closed")
        assert_eq(test.scope_teardown_state(scope), "Cancelling")

        local spawn_rejected = test.scope_register_child(scope, 104)
        assert_eq(spawn_rejected, false)

        local acq_rejected = test.scope_register_finalizer(scope, "Rejected Resource")
        assert_eq(acq_rejected, false)

        -- Broadcasting cancellation interrupts to child fibers
        local delivered_a = test.fiber_request_interrupt(fiber_a, "Cancelled")
        assert(delivered_a, "Delivered interrupt to unmasked Fiber 101 immediately")

        local delivered_b = test.fiber_request_interrupt(fiber_b, "Cancelled")
        assert_eq(delivered_b, false) -- Deferred because Fiber B is masked!

        -- 4. Gate-NEG-02 Verification (Scope Teardown Stage: Joining)
        test.scope_mark_joining(scope)
        assert_eq(test.scope_teardown_state(scope), "Joining")

        -- Invariant Gate-NEG-02:
        -- Host resources MUST NOT be released while any child fiber is active or masked!
        local current_releases = test.scope_current_releases(scope)
        assert_eq(current_releases, [])

        -- Worker B completes critical section, exits mask and delivers deferred cancellation
        local deferred = test.fiber_exit_mask(fiber_b)
        assert_eq(deferred, "Cancelled")
        assert_eq(test.fiber_state(fiber_b), "Interrupted")

        -- 5. Guaranteed LIFO finalization of host resources: 3 -> 2 -> 1
        local releases = test.scope_finalize(scope)
        assert_eq(test.scope_teardown_state(scope), "Done")

        assert_eq(
            releases,
            [
                "release:Worker Scratch Arena Buffer",
                "release:TCP Socket Listener",
                "release:PostgreSQL Connection Pool"
            ]
        )

        assert_eq(test.resource_is_active(res1), false)
        assert_eq(test.resource_is_active(res2), false)
        assert_eq(test.resource_is_active(res3), false)
    end
end
