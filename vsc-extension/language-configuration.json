{
  "comments": {
    "lineComment": "--",
    "blockComment": ["--[[", "]]"]
  },
  "brackets": [
    ["{", "}"],
    ["[", "]"],
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"", "notIn": ["string"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] },
    { "open": "[[", "close": "]]", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    { "open": "{", "close": "}" },
    { "open": "[", "close": "]" },
    { "open": "(", "close": ")" },
    { "open": "\"", "close": "\"" },
    { "open": "'", "close": "'" },
    { "open": "[[", "close": "]]" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*--#?region\\b",
      "end": "^\\s*--#?endregion\\b"
    }
  },
  "indentationRules": {
    "increaseIndentPattern": "^(?:\\s*(?:(?:local|pub|priv|export|pure)\\s+)*(?:function|struct|enum|trait|impl|extern|schema)\\b(?!\\s*=)(?!.*\\bend\\b)|\\s*(?:if|elseif|else|for|while|do|scoped|handle|with|match|effect|test|suite|describe|before_each|after_each|before_all|after_all)\\b(?!\\s*=)(?!.*\\bend\\b)|.*\\b(?:do|then|with)\\s*(?:--.*)?$|.*\\{\\s*(?:--.*)?$)",
    "decreaseIndentPattern": "^\\s*(?:(?:end|else|elseif|with)\\b|[\\}\\)\\]]).*$"
  },
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)"
}
