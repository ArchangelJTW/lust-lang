{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lust",
  "scopeName": "source.lust",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#constants" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#delimiters" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.lust",
          "begin": "--\\[\\[",
          "end": "\\]\\]"
        },
        {
          "name": "comment.line.double-dash.lust",
          "begin": "--",
          "end": "$"
        },
        {
          "name": "comment.line.number-sign.lust",
          "begin": "#",
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.other.multiline.lust",
          "begin": "\\[\\[",
          "end": "\\]\\]"
        },
        {
          "name": "string.quoted.double.lust",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lust",
              "match": "\\\\(?:[abfnrtvz\\\\\"']|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\}|[0-9]{1,3})"
            }
          ]
        },
        {
          "name": "string.quoted.single.lust",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.lust",
              "match": "\\\\(?:[abfnrtvz\\\\\"']|x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F]+\\}|[0-9]{1,3})"
            }
          ]
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lust",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.nil.lust",
          "match": "\\bnil\\b"
        },
        {
          "name": "variable.language.self.lust",
          "match": "\\bself\\b"
        },
        {
          "name": "constant.numeric.hex.lust",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.lust",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.lust",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.lust",
          "match": "\\b[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.other.lust",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(function)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*(?::[a-zA-Z_][a-zA-Z0-9_]*)?)",
          "captures": {
            "1": { "name": "storage.type.function.lust" },
            "2": { "name": "entity.name.function.lust" }
          }
        },
        {
          "match": "\\b(struct)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.lust" },
            "2": { "name": "entity.name.type.struct.lust" }
          }
        },
        {
          "match": "\\b(enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.lust" },
            "2": { "name": "entity.name.type.enum.lust" }
          }
        },
        {
          "match": "\\b(trait)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.lust" },
            "2": { "name": "entity.name.type.trait.lust" }
          }
        },
        {
          "match": "\\b(module)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": { "name": "storage.modifier.lust" },
            "2": { "name": "entity.name.section.module.lust" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.conditional.lust",
          "match": "\\b(if|then|elseif|else)\\b"
        },
        {
          "name": "keyword.control.repeat.lust",
          "match": "\\b(while|for|in|do|break|continue)\\b"
        },
        {
          "name": "keyword.control.return.lust",
          "match": "\\b(return)\\b"
        },
        {
          "name": "keyword.control.lust",
          "match": "\\b(end)\\b"
        },
        {
          "name": "storage.type.function.lust",
          "match": "\\b(function)\\b"
        },
        {
          "name": "storage.type.lust",
          "match": "\\b(struct|enum|trait|impl)\\b"
        },
        {
          "name": "storage.modifier.lust",
          "match": "\\b(local|ref|module|extern|use|const)\\b"
        },
        {
          "name": "keyword.operator.logical.lust",
          "match": "\\b(and|or|not)\\b"
        },
        {
          "name": "keyword.operator.lust",
          "match": "\\b(is|as)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.lust",
          "match": "\\b(int|float|bool|string|unknown)\\b"
        },
        {
          "name": "support.type.lust",
          "match": "\\b(Option|Result|Array|Map)\\b"
        },
        {
          "name": "entity.name.type.lust",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.lust",
          "match": "\\b(print|println|type|tostring)\\b"
        },
        {
          "match": "(?<=:)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.member.lust" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.lust" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.lust",
          "match": "\\+=|-=|\\*=|/="
        },
        {
          "name": "keyword.operator.comparison.lust",
          "match": "==|!=|~=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.lust",
          "match": "="
        },
        {
          "name": "keyword.operator.range.lust",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.arithmetic.lust",
          "match": "[+\\-*/%^]"
        },
        {
          "name": "keyword.operator.bitwise.lust",
          "match": "[|&]"
        },
        {
          "name": "keyword.operator.optional.lust",
          "match": "\\?"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.delimiter.lust",
          "match": "[:,.;]"
        },
        {
          "name": "punctuation.bracket.lust",
          "match": "[(){}\\[\\]]"
        }
      ]
    }
  }
}
